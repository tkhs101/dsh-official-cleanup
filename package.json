{
  "name": "dsh-official-cleanup",
  "version": "0.4.1",
  "description": "DeepSeek Harness Web UI cleanup: a direct Settings launcher instead of the sidebar 更多 menu, no unusable official DeepSeek provider card, and the official-model Session-log upload pinned off. · DSH 界面官方入口清理",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "harness-plugin",
    "web-ui"
  ],
  "license": "MIT",
  "author": "tkhs101",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tkhs101/dsh-official-cleanup.git"
  },
  "homepage": "https://github.com/tkhs101/dsh-official-cleanup#readme",
  "bugs": {
    "url": "https://github.com/tkhs101/dsh-official-cleanup/issues"
  },
  "type": "module",
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/"
  }
}
